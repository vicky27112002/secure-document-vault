# PostgreSQL Connection String
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/document_db

# JWT Secret Key (Generate using: openssl rand -hex 32)
JWT_SECRET_KEY=replace_with_32_byte_hex_secret_key

# AES-256-GCM Master Key (64 hex characters = 32 bytes)
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# File Storage & Limits
MAX_FILE_SIZE_MB=10
STORAGE_DIR=./storage
